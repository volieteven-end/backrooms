+bool FBRGameplayRules::CanExtract(const int32 ActivePlayers, const int32 PlayersInZone, const bool bObjectivesComplete)
+{
+	return bObjectivesComplete && ActivePlayers > 0 && PlayersInZone >= ActivePlayers;
+}
