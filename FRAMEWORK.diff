+	{
+		State->SetLevelPhase(EBRLevelPhase::Escaping);
+	}
+
+	OnTeamExtracted(NextMapName);
+	if (bAutoTravelOnExtraction && !NextMapName.IsNone() && GetWorld())
+	{
+		GetWorld()->ServerTravel(NextMapName.ToString());
+	}
+}
